    {
        "id": "storage-function",
        "type": "function",
        "z": "tab-storage",
        "name": "Influx point",
        "func": "let m = msg.payload || {};\nif (typeof m === 'string') { try { m = JSON.parse(m); } catch (e) { node.warn('Skipped machine-sensors message with invalid JSON'); return null; } }\nconst temperature = Number(m.temperature_c);\nconst vibration = Number(m.vibration_mm_s);\nconst pressure = Number(m.pressure_bar);\nif (!m.machine_id || !Number.isInteger(Number(m.order_id)) || Number(m.order_id) < 1 || Number(m.order_id) > 5 || !Number.isFinite(temperature) || !Number.isFinite(vibration) || !Number.isFinite(pressure)) { node.warn('Skipped machine-sensors message with invalid sensor value'); return null; }\nmsg.measurement = 'machine_measurements';\nmsg.timestamp = m.measurement_timestamp || '2026-09-20T00:00:00.000Z';\nmsg.payload = [{ temperature_c: temperature, vibration_mm_s: vibration, pressure_bar: pressure }, { machine_id: String(m.machine_id), order_id: String(m.order_id), extreme_value: String(Boolean(m.extreme_value)) }];\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 100,
        "wires": [
            [
                "storage-influx"
            ]
        ]
    },
    {
        "id": "storage-influx",
        "type": "influxdb out",
        "z": "tab-storage",
        "influxdb": "be152682336bdbe2",
        "name": "Write machine measurements",
        "measurement": "machine_measurements",
        "precision": "ms",
        "retentionPolicy": "",
        "database": "iot-data",
        "retentionPolicyV18Flux": "",
        "org": "my-iot-org",
        "bucket": "iot-data",
        "x": 650,
        "y": 100,
        "wires": []
    },
    {
        "id": "af077135fca409bd",
        "type": "mqtt in",
        "z": "tab-storage",

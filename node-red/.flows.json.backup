    {
        "id": "api-http",
        "type": "http in",
        "z": "tab-api",
        "name": "OrderCalculator callback",
        "url": "/orderapi",
        "method": "post",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "swagger-order",
        "x": 170,
        "y": 540,
        "wires": [
            [
                "api-store",
                "b53cd8c046b560b7"
            ]
        ]
    },
    {
        "id": "api-store",
        "type": "function",
        "z": "tab-api",
        "name": "Store latest orders",
        "func": "let body = msg.payload; if (typeof body === 'string') { try { body = JSON.parse(body); } catch (e) { msg.statusCode = 400; msg.payload = { error: 'Invalid JSON' }; return [null, msg]; } } const orders = Array.isArray(body) ? body : (Array.isArray(body.orders) ? body.orders : []); if (!orders.length) { msg.statusCode = 400; msg.payload = { error: 'No orders supplied' }; return [null, msg]; } flow.set('orders', orders); msg.payload = { status: 'accepted', orders }; return [msg, null];",
        "outputs": 2,
        "x": 410,
        "y": 540,
        "wires": [
            [
                "api-response",
                "calculate-orders-dashboard"
            ],
            [
                "api-error"
            ]
        ]
    },
    {
        "id": "api-response",
        "type": "http response",
        "z": "tab-api",
        "name": "Accepted",
        "statusCode": "200",
        "headers": {
            "Content-Type": "application/json"
        },
        "x": 660,
        "y": 540,
        "wires": []
    },
    {
        "id": "api-error",
        "type": "http response",
        "z": "tab-api",
        "name": "Bad request",
        "statusCode": "400",
        "headers": {
            "Content-Type": "application/json"
        },
        "x": 690,
        "y": 600,
        "wires": []
    },
    {
        "id": "initial-orders-inject",
        "type": "inject",
        "z": "tab-api",
        "name": "Show initial order data",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": "0.5",
        "topic": "",

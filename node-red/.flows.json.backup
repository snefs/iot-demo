    {
        "id": "gen-function",
        "type": "function",
        "z": "tab-generator",
        "name": "Generate 10 machines / orders 1-5",
        "func": "const decimal = (value, places) => Number(value.toFixed(places));\nconst extremeMachine = Math.random() < 0.25 ? Math.floor(Math.random() * 10) + 1 : null;\nfor (let machineId = 1; machineId <= 10; machineId++) {\n    const extreme = machineId === extremeMachine;\n    const machineData = { machine_id: `machine-${machineId}`, order_id: Math.floor(Math.random() * 5) + 1, temperature_c: extreme ? decimal(115 + Math.random() * 20, 1) : decimal(55 + Math.random() * 15, 1), vibration_mm_s: extreme ? decimal(18 + Math.random() * 8, 2) : decimal(1 + Math.random() * 3, 2), pressure_bar: extreme ? decimal(1 + Math.random() * 2, 2) : decimal(6 + Math.random() * 2, 2), extreme_value: extreme, measurement_timestamp: new Date().toISOString() };\n    node.send({ topic: 'machine-sensors', payload: JSON.stringify(machineData) });\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 180,
        "wires": [
            [
                "d1c98c4467c9a08e",
                "77fc1f95cca69e56"
            ]
        ]
    },
    {
        "id": "gen-split",
        "type": "split",
        "z": "tab-generator",
        "name": "One MQTT message per machine",
        "splt": "",
        "spltType": "str",
        "arraySplt": 1,
        "arraySpltType": "len",
        "stream": false,
        "addname": "",
        "property": "payload",
        "x": 400,
        "y": 240,
        "wires": [
            [
                "d1c98c4467c9a08e",
                "77fc1f95cca69e56"
            ]
        ]
    },
    {
        "id": "d1c98c4467c9a08e",
        "type": "mqtt out",
        "z": "tab-generator",
        "name": "",
        "topic": "machine-sensors",
        "qos": "",
        "retain": "",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "79ca3d4dc09a352e",

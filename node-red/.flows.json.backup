                "initial-orders-function"
            ]
        ]
    },
    {
        "id": "initial-orders-function",
        "type": "function",
        "z": "tab-api",
        "name": "Initial orders",
        "func": "const today = new Date();\nmsg.payload = { status: 'initial', orders: [1, 2, 3, 4, 5].map(order_id => { const delivery = new Date(today); delivery.setDate(today.getDate() + order_id); return { order_id, start_date: today.toISOString().slice(0, 10), planned_delivery: delivery.toISOString().slice(0, 10), quality: 100, comment: 'initial data' }; }) };\nreturn msg;",
        "outputs": 1,
        "x": 390,
        "y": 180,
        "wires": [
            [
                "calculate-orders-dashboard"
            ]
        ]
    },
    {
        "id": "calculate-orders-inject",
        "type": "inject",
        "z": "tab-api",
        "name": "Calculate orders now",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": "",
        "topic": "",
        "payload": "{}",
        "payloadType": "json",
        "x": 180,
        "y": 400,
        "wires": [
            [
                "calculate-orders-request"
            ]
        ]
    },
    {
        "id": "calculate-orders-request",
        "type": "http request",
        "z": "tab-api",
        "name": "Trigger OrderCalculator",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://python-app:8000/calculate",
        "persist": false,
        "senderr": true,
        "headers": [
            {
                "keyType": "Content-Type",
                "keyValue": "Content-Type",
                "valueType": "application",
                "valueValue": "application/json"
            }
        ],
        "x": 430,
        "y": 400,
        "wires": [
            [
                "calculate-orders-dashboard",
                "8217921a86ffa825"
            ]
        ]
    },
    {
        "id": "calculate-orders-dashboard",
        "type": "function",
        "z": "tab-api",
        "name": "Persist calculated orders",
        "func": "const orders = (msg.payload && msg.payload.orders) || [];\nconst today = new Date().toISOString().slice(0, 10);\nconst normalized = orders.filter(o => Number(o.order_id) >= 1 && Number(o.order_id) <= 5).map(o => ({ order_id: Number(o.order_id), start_date: o.start_date || today, planned_delivery: o.planned_delivery || o.delivery_date || today, quality: Number.isFinite(Number(o.quality)) ? Number(o.quality) : 100, comment: o.comment || 'quality OK', delivery_remark: o.delivery_remark || o.comment || 'planned delivery' }));\nconst fixedTimeNs = Date.parse('2026-09-20T00:00:00.000Z') * 1000000;\nconst influxMessages = normalized.map(o => ({ measurement: 'order_results', payload: [{ time: fixedTimeNs, quality: o.quality, remark: o.comment, planned_delivery: o.planned_delivery, delivery_remark: o.delivery_remark }, { orderId: String(o.order_id) }] }));\nreturn [null, influxMessages];",
        "outputs": 2,
        "x": 750,
        "y": 380,
        "wires": [
            [],
            [
                "orders-influx"
            ]
        ]
    },
    {
        "id": "orders-influx",
        "type": "influxdb out",
        "z": "tab-api",
        "influxdb": "be152682336bdbe2",
        "name": "Write order results",
        "measurement": "order_results",
        "precision": "ms",
        "database": "iot-data",
        "org": "my-iot-org",
        "bucket": "iot-data",
        "x": 970,
        "y": 400,
        "wires": []
